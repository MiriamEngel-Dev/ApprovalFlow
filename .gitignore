# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Env / secrets
.env
.env.local
/dapr/secrets.json

# Test / coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Microsoft Office lock files (created while a .pptx/.docx/.xlsx is open)
~$*.pptx
~$*.docx
~$*.xlsx

# Docker volumes captured locally (if any)
.docker-data/

# Locally trusted extra CA certs (corporate proxy / AV TLS inspection) — machine-specific,
# never committed. See docker/certs/README.md.
docker/certs/*.crt
