# Copy to .env and adjust. Never commit the real .env — it is gitignored.

# --- PostgreSQL (single instance, one logical database per service — ADR-009) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=approvalflow
POSTGRES_PASSWORD=changeme
SUBMISSION_DB=submission_db
DECISION_DB=decision_db
PAYMENT_DB=payment_db
AUDIT_DB=audit_db

# --- Redis (Dapr pub/sub + state store backend) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- LLM provider (swappable per service — ADR-008) ---
# stub  = deterministic fixture-mapped responses, used in CI/eval, no network calls
# gemini = Gemini 2.0 Flash, requires LLM_API_KEY
LLM_PROVIDER=stub
LLM_API_KEY=

# --- AuthN/AuthZ (N1) ---
JWT_SIGNING_KEY=change-me-to-a-long-random-string

# --- Service ports ---
SUBMISSION_SERVICE_PORT=3000
DECISION_SERVICE_PORT=3001
PAYMENT_SERVICE_PORT=3002
AUDIT_SERVICE_PORT=3003
NGINX_PORT=8080
UI_PORT=5173

# --- Policy defaults (hot-reloadable at runtime via PUT /api/policy — M13) ---
AUTONOMY_CEILING=250
AUTONOMY_CONFIDENCE=0.80
